  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7ecc8e7f621a517f18a7c73b81083d10, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BriefingManager
  pages:
  - text: "Ol\xE1! hoje vou ensinar-te o que \xE9 nutri\xE7\xE3o!\nNutri\xE7\xE3o
      \xE9 tudo aquilo que acontece quando comemos alimentos e o nosso corpo usa
      esses alimentos para viver, crescer e ter energia.\nOs alimentos t\xEAm coisas
      muito importantes chamadas nutrientes"
  - text: "\U0001F35E Carboidratos:\LD\xE3o energia para correr, brincar e estudar\n\U0001F357
      Prote\xEDnas:\LAjudam a construir m\xFAsculos e a crescer\n\U0001F951 Gorduras
      saud\xE1veis:\LD\xE3o energia e ajudam o corpo a funcionar bem\nVitaminas e
      minerais:\LProtegem o corpo e ajudam a n\xE3o ficar doente"
  - text: "E claro, \xC1gua\LEssencial \xE0 vida!\nE h\xE1 uma regra muito importante:\LAlimenta\xE7\xE3o
      equilibrada = comer um pouco de tudo, sem exageros\nSe comeres bem:\L\u2705
      Tens mais energia\L\u2705 Ficas mais saud\xE1vel\L\u2705 Cresces melhor"
  contentText: {fileID: 519162660}
  nextButton: {fileID: 1129572426}
  startButton: {fileID: 1356701758}
  gameScene: Connect3QuizQuestions
